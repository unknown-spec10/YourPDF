# Redis Configuration (For Celery broker and task states)
REDIS_URL=redis://localhost:6379/0

# Redis password (required by both compose files via --requirepass).
# Local dev works unset: compose defaults to a documented dev password and
# threads it into each service's REDIS_URL. Set a strong value in production.
#REDIS_PASSWORD=change-me-in-production

# Compose REDIS_URL example (password interpolated from REDIS_PASSWORD):
#REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# Optional shared API key (empty/disabled by default). Set backend API_KEY and frontend NEXT_PUBLIC_API_KEY to the same value.
#API_KEY=change-me-in-production

# Flower monitoring basic auth (prod compose only, port 5555).
# Compose defaults are documented dev values; set strong values in production.
#FLOWER_USER=admin
#FLOWER_PASSWORD=change-me-in-production
