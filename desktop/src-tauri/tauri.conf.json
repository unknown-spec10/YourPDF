{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YourPDF Desktop",
  "version": "0.1.3",
  "identifier": "com.yourpdf.desktop",
  "build": {
    "frontendDist": "../../frontend/out",
    "beforeBuildCommand": "node scripts/build-frontend.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../build/sidecar/yourpdf-backend": "sidecar/yourpdf-backend",
      "../bin": "bin",
      "../licenses": "licenses"
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/unknown-spec10/YourPDF/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1MDE1N0FDRjlDRjMwNzMKUldSek1NLzVyRmNCcFJxQ0ROOVZ4TEZ6UVFqZzZVK0ZuQit3eU9IQmJqekVTbmtxTXJhc281WjQK",


      "windows": {
        "installMode": "passive"
      }
    }
  }
}
